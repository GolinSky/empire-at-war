pipeline {
    agent { label 'windows-local-unity' }
    options {
        disableConcurrentBuilds()
        copyArtifactPermission('EmpireAtWar-Publish-GitHub')
        skipDefaultCheckout(true)
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '3'))
    }
    parameters {
        booleanParam(name: 'PUBLISH_GITHUB', defaultValue: false, description: 'After a successful build, queue EmpireAtWar-Publish-GitHub for this build. Creates a verified GitHub draft tagged with the build version; never publishes it.')
        booleanParam(name: 'UPLOAD_DIAGNOSTICS_SYMBOLS', defaultValue: false, description: 'Upload IL2CPP symbols with the Unity Cloud service account for the linked project.')
    }
    stages {
        stage('Prepare committed main') {
            steps {
                script { env.CI_TOOLS = 'F:/Jenkins/app/build-tools' }
                powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase Prepare'
                script { env.CI_TOOLS = 'F:/UnityCI/empire-at-war/Tools/Jenkins' }
            }
        }
        stage('Build Windows x64') {
            steps { powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase Build' }
        }
        stage('Upload Diagnostics symbols') {
            when { expression { params.UPLOAD_DIAGNOSTICS_SYMBOLS } }
            options { timeout(time: 20, unit: 'MINUTES') }
            steps {
                withCredentials([string(credentialsId: 'unity-diagnostics-service-account', variable: 'UNITY_SA_AUTH_HEADER')]) {
                    powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase Symbols'
                }
            }
        }
        stage('Package player') {
            steps { powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase Package' }
        }
    }
    post {
        always {
            script {
                parallel(
                    archive: {
                        try {
                            archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: false
                            powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase ArchiveComplete'
                        } finally {
                            writeFile file: 'archive-finished', text: 'finished'
                        }
                    },
                    resources: {
                        powershell '& "$env:CI_TOOLS/Invoke-LocalBuild.ps1" -Phase ArchiveMonitor'
                    },
                    failFast: true
                )
            }
            // Compiler Issues tab: C# errors/warnings from the Unity log, linked to the CI snapshot sources.
            // Runs after archiving so a parser problem never blocks artifact recovery.
            recordIssues(enabledForFailure: true, skipBlames: true,
                tool: msBuild(id: 'unity-compiler', name: 'Unity Compiler', pattern: 'artifacts/Unity.log'),
                sourceDirectories: [[path: 'F:/UnityCI/empire-at-war']])
        }
        success {
            script {
                if (params.PUBLISH_GITHUB) {
                    // wait: false - the publish job waits for this build to finish and needs the single executor.
                    build job: 'EmpireAtWar-Publish-GitHub', wait: false, parameters: [
                        string(name: 'SOURCE_BUILD', value: env.BUILD_NUMBER),
                        booleanParam(name: 'PRERELEASE', value: true)
                    ]
                    currentBuild.description = 'GitHub draft queued'
                }
            }
        }
    }
}
