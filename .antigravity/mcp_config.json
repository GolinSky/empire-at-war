{
  "mcpServers": {
    "blender": {
      "command": "C:\\Users\\golin\\.local\\bin\\uvx.exe",
      "args": ["mcp-for-blender==2.1.3"],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_SAFE_MODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "penpot-local": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "F:\\Private\\empire-at-war\\Tools\\Penpot\\start.mjs"
      ]
    },
    "empire-vault": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\golin\\AppData\\Local\\AI-Tools\\mcpvault\\0.16.0\\node_modules\\@bitbonsai\\mcpvault\\dist\\server.js",
        "F:\\Private\\empire-at-war\\EmpireAtWarDocumentation"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from", "graphifyy[mcp]==0.9.54",
        "python", "Tools/Graphify/run.py", "mcp"
      ],
      "env": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      }
    },
    "unity": {
      "command": "unity",
      "args": [
        "mcp"
      ]
    }
  }
