{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender==2.1.3"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_SAFE_MODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "penpot-local": {
      "command": "node",
      "args": [
        "Tools/Penpot/start.mjs"
      ]
    },
    "unity": {
      "command": "unity",
      "args": ["mcp", "--project-path", "."]
    },
    "serena": {
      "type": "http",
      "url": "http://127.0.0.1:9122/mcp"
    },
    "empire-vault": {
      "command": "node",
      "args": [
        "Tools/McpVault/node_modules/@bitbonsai/mcpvault/dist/server.js",
        "EmpireAtWarDocumentation"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from", "graphifyy[mcp]==0.9.54",
        "python", "Tools/Graphify/run.py", "mcp"
      ],
      "env": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      }
    }
  }
}
