{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7412417ab29e41009450c9df91c1bfb4",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SeismicCharge (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -300,
            "y": 0,
            "width": 270,
            "height": 450
        }
    },
    "m_Slots": [
        {
            "m_Id": "56a2cbb2113a4c17a3ce598bb3536589"
        },
        {
            "m_Id": "98dfa61371b241b08a74528ad6ac8ff8"
        },
        {
            "m_Id": "349d7c8801e64b80b74c4988c0b3e56c"
        },
        {
            "m_Id": "3d6287947b6946b8a65c26c946baa995"
        },
        {
            "m_Id": "0c85369186a3478c974d57563939c0a7"
        },
        {
            "m_Id": "7b8e9901614142f7aa86718c70d3b979"
        },
        {
            "m_Id": "ab3904187f3f4e7e85a14c5964cf4d70"
        },
        {
            "m_Id": "aed32142ac714cd195585991448b9222"
        },
        {
            "m_Id": "f8e03a60efc94b509913585e946b17e1"
        },
        {
            "m_Id": "2c0c2a4e0b4a45a19165576026480796"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SeismicCharge",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = (UV - 0.5) * 2.0;\nfloat distance = length(p);\nfloat angle = atan2(p.y, p.x);\nfloat noise = sin(angle * 23.0 + Radius * 15.0) * sin(angle * 37.0 - Radius * 9.0);\nfloat distorted = distance + noise * EdgeNoise * Width;\nfloat width = max(Width, 0.001);\nfloat ring = smoothstep(Radius - width, Radius, distorted) * (1.0 - smoothstep(Radius, Radius + width, distorted));\nfloat core = pow(saturate(1.0 - distance / max(Radius, 0.001)), 2.0);\nAlpha = lerp(ring, core, saturate(Core)) * Opacity;\nColorOut = Color.rgb * Intensity;"
}

