    - key: 8
      value:
        icon: {fileID: 21300000, guid: 2e60ab884151e074caf67bb570ba533b, type: 3}
        displayName: Ion Pulse
        description: Turn the nearest ion cannon broadside to the target, then fire
          a slow ion wave. Enemy ships hit are disabled for 10 s. No hull damage.
          Move/Stop cancels turning; 60 s recovery.
        duration: 80
        recoveryDelay: 60
        canCancel: 0
        isToggle: 0
        requiresEnemyTarget: 1
        range: 1000
        aiUse: 2
        autoPower: 3
