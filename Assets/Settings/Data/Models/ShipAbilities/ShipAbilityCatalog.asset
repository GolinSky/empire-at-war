  definitions:
    keyValue:
    - key: 8
      value:
        icon: {fileID: 21300000, guid: 2e60ab884151e074caf67bb570ba533b, type: 3}
        displayName: Ion Pulse
        description: Charge for 4 s, align a surviving broadside cannon, then fire
          a slow ion wave. Enemy ships hit are disabled for 12 s. 10% chance to disable
          Malevolence instead. No hull damage. Move/Stop cancels charging; 60 s recovery.
        duration: 80
        recoveryDelay: 60
        canCancel: 0
        isToggle: 0
        requiresEnemyTarget: 1
        range: 500
        aiUse: 2
        settings:
          rid: 6801466862182334539
    - key: 10
      value:
        icon: {fileID: 21300000, guid: 704f7450173727e43becc6f5e49c86ed, type: 3}
        displayName: Laser Beam
        description: Fire a focused laser beam at an enemy. Deals 6,000 beam damage
          continuously over 8 s, then recovers for 50 s.
        duration: 8
        recoveryDelay: 50
        canCancel: 0
        isToggle: 0
        requiresEnemyTarget: 1
        range: 500
        aiUse: 2
        settings:
          rid: 7607833764655792203
    - key: 25
      value:
        icon: {fileID: 21300000, guid: 704f7450173727e43becc6f5e49c86ed, type: 3}
        displayName: Fire Composite Beam
        description: Fire the composite beam for 6 seconds at an enemy ship larger
          than a corvette. Deals 1,000 damage before armor/shield modifiers, with
          only 10% damage against shields. Recovers in 45 seconds.
        duration: 6
        recoveryDelay: 45
        canCancel: 0
        isToggle: 0
        requiresEnemyTarget: 1
        range: 375
        aiUse: 2
        settings:
          rid: 6801466921437888600
