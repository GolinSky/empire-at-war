    - key: 200
      value:
        matchups: {fileID: 11400000, guid: 42b9d7cba8dab804589da64ac8ce570f, type: 2}
        description: 'Imperial squadron: seven TIE Fighters, each with 50 hull, no
          shields and two laser cannons. Screens carriers against fighters and bombers;
          vulnerable to anti-fighter corvettes.'
        role: "Fighter \xB7 Interceptor"
