  ships:
    keyValue:
    - key: 202
      value:
        matchups: {fileID: 11400000, guid: 6887148f139f280438d9d67f651593e6, type: 2}
        description: 12,000 hull; 8,000 shields; speed 175. Four heavy 4-burst artillery-rocket
          launchers and two 6-burst barrage-rocket launchers. Targetable shield generator,
          two engines and tractor beam. Six light dual turbolasers, four heavy laser
          cannons and hangar are not separately targetable. Full Salvo accelerates
          rockets and slows other weapons. Tractor Beam restricts enemy movement.
          TIE-Interceptor complement.
        role: Artillery / Cruiser
        iconKey: 3896a253ad3c5024b8b7260fb0c214a9:21300000
        isHero: 0
        <Name>k__BackingField: "Victory I Star Destroyer \u2014 Advanced Loadout"
        <MaxCount>k__BackingField: 10
        <AvailableLevel>k__BackingField: 2
        <Price>k__BackingField: 5000
        <BuildTime>k__BackingField: 30
        <UnitCapacity>k__BackingField: 4
        <Icon>k__BackingField: {fileID: 21300000, guid: 3896a253ad3c5024b8b7260fb0c214a9,
          type: 3}
    - key: 201
      value:
        matchups: {fileID: 11400000, guid: 55d62e93f93a1f34badabec3d1a83f4a, type: 2}
        description: '20,000 hull; 16,000 shields; speed 250. Targetable: six heavy
          two-burst turbolasers, two heavy two-burst turbo-ion cannons, two medium
          turbo-ion cannons, two shield generators, two engines, tractor beam and
          hangar. Additional weapons: three medium three-burst turbolasers, four
          light turbolasers and four laser cannons. Launches TIE Interceptors, TIE
          Brutes and TIE Punishers. Boost Engine Power doubles speed, quadruples
          weapon delays and pauses shield regeneration for 20 s. Tractor Beam slows
          a selected enemy to 40% speed.'
        role: Capital ship / Advanced carrier
        iconKey: b8f66d736a9c0a841b8957320119ca55:21300000
        isHero: 0
        <Name>k__BackingField: ISD I
        <MaxCount>k__BackingField: 3
        <AvailableLevel>k__BackingField: 3
        <Price>k__BackingField: 8500
        <BuildTime>k__BackingField: 40
        <UnitCapacity>k__BackingField: 5
