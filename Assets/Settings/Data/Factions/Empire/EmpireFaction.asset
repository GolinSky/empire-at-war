        matchups: {fileID: 11400000, guid: 7c52c799b307ef24ab481ca1f82ccfb9, type: 2}
        description: 'Imperial squadron: four TIE Bombers, each with 60 hull, no
          shields, a laser cannon and a proton torpedo launcher. Attacks larger ships;
          vulnerable to fighters and anti-fighter weapons.'
        role: Bomber / Anti-ship
        iconKey: 6deef1e660f9c3a41b4d343f91418382:21300000
