        <UnitCapacity>k__BackingField: 1
        <Icon>k__BackingField: {fileID: 21300000, guid: 83b847ad5990b534c940f6bcc1abfbf1,
          type: 3}
    - key: 5
      value:
        matchups: {fileID: 11400000, guid: 7b61aabb13894524ebe6a77baaaeba46, type: 2}
        description: Five V-19 Torrent interceptors, each with 70 hull, 30 shields
          and two laser cannons. Screens Republic capital ships and bombers, intercepting
          hostile fighters and bombers. Vulnerable to corvettes and dedicated anti-fighter
          weapons.
        role: "Fighter \xB7 Interceptor"
        iconKey: 47bb7927ce6b11a40a4930c0e6e95426:21300000
        isHero: 0
        <Name>k__BackingField: V-19 Torrent Squadron
        <MaxCount>k__BackingField: 10
        <AvailableLevel>k__BackingField: 1
