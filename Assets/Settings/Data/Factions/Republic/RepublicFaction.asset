        <Icon>k__BackingField: {fileID: 21300000, guid: 2556b3b94de26234e872c9e6cc31a730,
          type: 3}
    - key: 200
      value:
        matchups: {fileID: 11400000, guid: 2b08713a371fcbd4c98840e4d71f3353, type: 2}
        description: Republic heavy cruiser built to destroy corvettes and frigates.
          Two enhanced turbolaser, four dual medium turbolaser, two dual heavy turbolaser,
          two concussion missile and one ion cannon battery; fourteen targetable
          hardpoints. Boost Weapon Power doubles fire rate for 20 seconds, halves
          speed and stops shield recovery; 60-second cooldown.
        role: Heavy cruiser / Anti-corvette / Anti-frigate
        iconKey: 552ac5636e4f65c44994f1337d051b8a:21300000
        isHero: 0
        <Name>k__BackingField: Victory-class Star Destroyer
