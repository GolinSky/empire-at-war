  squadrons:
    keyValue:
    - key: 2
      value:
        matchups: {fileID: 11400000, guid: e6970a03cdd980243ba2662086173178, type: 2}
        description: Five durable ARC-170 multirole starfighters, each with two heavy
          forward lasers, a rear laser turret and one proton torpedo per attack run.
          105 hull and 35 shields per fighter. Effective against fighters, bombers
          and light ships; can threaten capital-ship hardpoints. Dedicated bombers
          have greater torpedo output.
        role: "Heavy fighter \xB7 Fighter-bomber"
        iconKey: 14a57369a6b0b6447917d19a5a8114c8:21300000
