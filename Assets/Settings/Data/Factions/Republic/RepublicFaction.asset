        <Icon>k__BackingField: {fileID: 21300000, guid: 771dbf8529c7a394b864ffcb0bd556d7,
          type: 3}
    - key: 10
      value:
        matchups: {fileID: 11400000, guid: fcc5b4e54bcb0104486e9c66ffac9685, type: 2}
        description: Late Clone Wars Republic prototype battleship. Six heavy twin
          turbolasers, two heavy twin ion cannons, fourteen turbolaser batteries
          and five ion batteries deliver heavy direct fire. Laser Beam replaces Tractor
          Beam. Carries ARC-170s and Y-Wings; no point defense leaves it vulnerable
          to bombers.
        role: Capital / Battleship / Heavy direct fire
        iconKey: 467453f64c3f87547aa904ce3fda10b9:21300000
        isHero: 0
        <Name>k__BackingField: Imperator-class Star Destroyer
        <MaxCount>k__BackingField: 1
        <AvailableLevel>k__BackingField: 3
        <Price>k__BackingField: 8000
        <BuildTime>k__BackingField: 90
        <UnitCapacity>k__BackingField: 4
        <Icon>k__BackingField: {fileID: 21300000, guid: 467453f64c3f87547aa904ce3fda10b9,
          type: 3}
    - key: 11
      value:
        matchups: {fileID: 11400000, guid: e7d55be5d7cbd0446bea19c2532e8c8e, type: 2}
        description: Republic prototype stealth corvette with 850 hull, 900 shields,
          two concussion missile launchers and two laser cannons. Cloak hides it
          from enemy sensors and targeting for up to 80 seconds; weapons are disabled
          while cloaked. Retains friendly vision for reinforcement deployment.
        role: "Stealth \xB7 Reconnaissance"
        iconKey: 2556b3b94de26234e872c9e6cc31a730:21300000
        isHero: 0
        <Name>k__BackingField: IPV-2C Stealth Corvette
