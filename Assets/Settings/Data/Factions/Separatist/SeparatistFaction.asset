    - key: 105
      value:
        matchups: {fileID: 11400000, guid: 699f1928bcda3284f9ae9ff3f683f5d8, type: 2}
        description: Support carrier with 2 turbolasers, 6 lasers and 2 ion cannons.
          Deploys 11 Vulture Droid and 8 Advanced Droid Bomber squadrons, with one
          of each active at once. Power to Weapons improves self-defense.
        role: "Capital \xB7 Dedicated carrier"
        iconKey: 5f8bc4a82cc113244b19a13b489bb0f0:21300000
