  m_Script: {fileID: 11500000, guid: 02badccc713aa9748baa10babdf75dd5, type: 3}
  m_Name: RebellionFaction
  m_EditorClassIdentifier: Assembly-CSharp::EmpireAtWar.Models.Factions.FactionDefinition
  factionType: 2
  ships:
    keyValue:
    - key: 300
      value:
        matchups: {fileID: 11400000, guid: f2965c2e6d7e7ea42abf7182f9b60c04, type: 2}
        description: Rebel general-purpose frigate effective against corvettes and
          light cruisers. Four turbolaser batteries, four laser cannon batteries
          and targetable engines. Boost Shield Strength increases shield recovery
          tenfold for 15 seconds, reducing speed by 20% and weapon damage by 50%;
          60-second cooldown.
        role: General-purpose frigate / Anti-corvette
        iconKey: a5d07dd53c680c6408f3e98f4ce75765:21300000
        isHero: 0
        <Name>k__BackingField: Nebulon-B Frigate
        <MaxCount>k__BackingField: 10
        <AvailableLevel>k__BackingField: 2
        <Price>k__BackingField: 2200
        <BuildTime>k__BackingField: 30
        <UnitCapacity>k__BackingField: 2
        <Icon>k__BackingField: {fileID: 21300000, guid: a5d07dd53c680c6408f3e98f4ce75765,
          type: 3}
    - key: 301
      value:
        matchups: {fileID: 11400000, guid: f0593bb86a7249c46b0e783c993fec3b, type: 2}
        description: Rebel anti-fighter and anti-bomber corvette with eight laser
          cannons, 500 hull and 800 shields. Power to Engines doubles speed for 20
          seconds, triples weapon delays and stops shield regeneration; 50-second
          recovery. Use it to screen larger ships, chase strikecraft or escape. Weak
          against frigates and capital ships.
        role: Anti-fighter / Anti-bomber
        iconKey: 68a48dec07691c448a7ed517f75c5a1a:21300000
        isHero: 0
        <Name>k__BackingField: Corellian Corvette / CR90
        <MaxCount>k__BackingField: 10
        <AvailableLevel>k__BackingField: 1
        <Price>k__BackingField: 1250
        <BuildTime>k__BackingField: 25
        <UnitCapacity>k__BackingField: 1
        <Icon>k__BackingField: {fileID: 21300000, guid: 68a48dec07691c448a7ed517f75c5a1a,
          type: 3}
    - key: 302
      value:
        matchups: {fileID: 11400000, guid: 061d31c86b87ab34ca40a0d06290c8a5, type: 2}
        description: Heavy Rebel capital ship with 8,500 hull, 2,500 shields and
          70/s shield regeneration. Four enhanced turbolaser, four dual heavy turbolaser,
          two turbolaser and two ion cannon batteries and targetable engines. No
          targetable shield generator. Power to Shields boosts regeneration tenfold
          for 15 seconds, reduces speed by 20% and weapon damage by 50%; 40-second
          cooldown. Strong against frigates; vulnerable to bombers.
        role: Heavy capital ship / Anti-frigate
        iconKey: b95f55f2e2f204f42a94f0c44c5baa85:21300000
        isHero: 0
        <Name>k__BackingField: Mon Calamari Star Cruiser / MC80
        <MaxCount>k__BackingField: 10
        <AvailableLevel>k__BackingField: 4
        <Price>k__BackingField: 4500
        <BuildTime>k__BackingField: 30
        <UnitCapacity>k__BackingField: 4
        <Icon>k__BackingField: {fileID: 21300000, guid: b95f55f2e2f204f42a94f0c44c5baa85,
          type: 3}
    - key: 303
      value:
        matchups: {fileID: 11400000, guid: 6f751ab5214d08f468a4ba44b5cf1107, type: 2}
        description: 'Admiral Ackbar''s hero command cruiser: 15,000 hull, 12,000
          shields, four turbolaser, four dual heavy turbolaser, four dual medium
          turbolaser and four ion cannon batteries. Shield generator, engines and
          fighter bay can be destroyed. Concentrate Fire grants Home One +50% damage
          against one selected enemy and directs nearby fleet units to attack it
          for 15 s; 20 s recovery. Power to Shields grants 10x shield recovery, 80%
          speed and 3x weapon delays for 15 s; 20 s recovery. Fleet Commander supports
          allied Rebel ships and squadrons throughout the battle. Carries A-Wing
          and Y-Wing squadrons.'
        role: Hero capital ship / Fleet command cruiser
        iconKey: f71730a251297854b97875858cdb2249:21300000
        isHero: 1
        <Name>k__BackingField: Home One / Admiral Ackbar
        <MaxCount>k__BackingField: 1
        <AvailableLevel>k__BackingField: 5
        <Price>k__BackingField: 6500
        <BuildTime>k__BackingField: 45
        <UnitCapacity>k__BackingField: 4
        <Icon>k__BackingField: {fileID: 21300000, guid: f71730a251297854b97875858cdb2249,
          type: 3}
    - key: 304
      value:
        matchups: {fileID: 11400000, guid: 33184172200c25f489618d48b34a6a2b, type: 2}
        description: MC75 capital ship armed with proton and ion torpedoes, close-range
          turbolasers, heavy lasers and point defense. Full Salvo triples torpedo
          fire rate while slowing its other weapons for 20 seconds. Carries X-Wing
          and Y-Wing squadrons.
        role: Torpedo capital ship / Shield disabler
        iconKey: 80ed7da538f88cc41a288cdfeecf753a:21300000
        isHero: 0
        <Name>k__BackingField: MC75 Profundity
        <MaxCount>k__BackingField: 3
        <AvailableLevel>k__BackingField: 3
        <Price>k__BackingField: 5500
        <BuildTime>k__BackingField: 40
        <UnitCapacity>k__BackingField: 4
        <Icon>k__BackingField: {fileID: 21300000, guid: 80ed7da538f88cc41a288cdfeecf753a,
          type: 3}
    - key: 305
      value:
        matchups: {fileID: 11400000, guid: 41d0193e2f230fa4d9f62ec405cfd0c4, type: 2}
        description: MC80 Independence dreadnought with eight medium dual turbolasers
          and six medium dual turbo-ion cannons. Three engines and three hangars
          are targetable. Eight light turbolasers, six light turbo-ions and eight
          heavy lasers remain operational until hull destruction. Power to Shields
          accelerates regeneration while reducing movement and firing rate. Carries
          X-Wing, Y-Wing and A-Wing squadrons.
        role: Dreadnought / Fleet anchor
        iconKey: d1df96d57bfbbb049952971439112bf5:21300000
        isHero: 0
        <Name>k__BackingField: MC80 Independence
        <MaxCount>k__BackingField: 3
        <AvailableLevel>k__BackingField: 5
        <Price>k__BackingField: 7000
        <BuildTime>k__BackingField: 68
        <UnitCapacity>k__BackingField: 5
        <Icon>k__BackingField: {fileID: 21300000, guid: d1df96d57bfbbb049952971439112bf5,
          type: 3}
    - key: 306
      value:
        matchups: {fileID: 11400000, guid: cfffd4866130fe34faafe00094f56ef4, type: 2}
        description: Corellian Battlecruiser reinforces the fleet with replacement
          X-Wing, A-Wing and Y-Wing bomber squadrons from one hangar. Armed with
          four heavy two-burst barrage rocket launchers, eight medium turbolasers
          and five laser cannons. Power to Shields doubles shield regeneration for
          15 seconds.
        role: Fleet reinforcement / Squadron support
        iconKey: fe1f61f0ff4f03a47a7a2a16340c510d:21300000
        isHero: 0
        <Name>k__BackingField: Corellian Battlecruiser
        <MaxCount>k__BackingField: 3
        <AvailableLevel>k__BackingField: 2
        <Price>k__BackingField: 2000
        <BuildTime>k__BackingField: 81
        <UnitCapacity>k__BackingField: 3
        <Icon>k__BackingField: {fileID: 21300000, guid: fe1f61f0ff4f03a47a7a2a16340c510d,
          type: 3}
  squadrons:
    keyValue:
    - key: 1
      value:
        matchups: {fileID: 11400000, guid: 5b8d183986aa6104291623ddd0143550, type: 2}
        description: A squadron of fighters. Surviving members share orders and take
          damage individually.
        role: "Fighter squadron \xB7 Interceptor"
        iconKey: 524d65b06058f0a428ee3d2a9b9b78e9:21300000
        isHero: 0
        <Name>k__BackingField: A-Wing Interceptor Squadron
        <MaxCount>k__BackingField: 10
