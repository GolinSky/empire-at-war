    - _isShown : bool
}
interface IEndGamePresenter {
}
MonoBehaviour <|-- EndGameLossRow
BaseUi <|-- EndGameUi
UiController <|-- EndGameUiController
IEndGamePresenter <|.. EndGameUiController
IObserver <|.. EndGameUiController
IOrderedDisposable <|.. EndGameUiController
