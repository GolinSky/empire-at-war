@startuml
class EndGameLossCatalog {
    - _factions : FactionCatalog
    - _icons : IShipIconProvider
    - _stations : StationLevelData
    - _platforms : DefendPlatformCatalog
    - _facilities : MiningFacilityCatalog
    - _sites : CaptureSiteData
}
class EndGameLossRow {
}
class EndGameUi {
    - _presenter : IEndGamePresenter
    - _isInitialized : bool
    + TooltipHover : TooltipHoverView
}
class EndGameUiController {
    - _battleVictoryNotifier : INotifier<BattleResult>
    - _view : EndGameUi
    - _returnToMenu : Action
    - _lossCatalog : EndGameLossCatalog
    - _result : BattleResult
    - _tooltips : TooltipRequests
    - _tooltipHover : TooltipHoverSubscription
